{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "differencemaker0/messenger",
    "type": "project",
    "description": "The skeleton for FB Messenger Webhook. https://blog.orium.com/how-to-install-a-node-js-project-within-composer-df9561a8cdb8",
    "license": "MIT",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "differencemaker0/messenger",
                "version": "v1.1-beta",
                "type": "node_modules",
                "source": {
                    "type": "git",
                    "reference": "presentation",
                    "url": "https://github.com/DifferenceMaker0/messenger.git"
                }
            }
        }
    ],
    "require": {
        "oomphinc/composer-installers-extender": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DifferenceMaker0\\Messenger\\": "messenger/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true
        }
    },
    "extra": {
        "installer-types": [
            "node_modules"
        ],
        "installer-paths": {
            "node_modules/{$name}": [
                "type:node_modules"
            ]
        }
    }
}